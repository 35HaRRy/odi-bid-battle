# Sanitized examples only. Inject actual values through your deployment secret store.
# Production DATABASE_URL lives in Vercel Production env, not in files.
DATABASE_URL=
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
# Empty means socket IP only. Never use true or a hop count.
TRUSTED_PROXIES=
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=accounts@example.test
# Set DATABASE_URL privately. Never reuse production databases in tests.
# LEGACY_ACCOUNT_EMAIL is used only by the explicit provisioning command.
# Leave all four Google settings absent to disable Google. Never put these in VITE_*.
# GOOGLE_CLIENT_ID=REPLACE_PRIVATELY
# GOOGLE_CLIENT_SECRET=REPLACE_PRIVATELY
# GOOGLE_REDIRECT_URI=https://app.example.test/api/auth/google/callback
# AUTH_STATE_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_PADDED_BASE64_KEY
